{
  "compilerOptions": {
    "target": "es2024",
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": ["node", "trss-yunzai"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },
    "outDir": "./lib",
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "./src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
