{
  "compilerOptions": {
    "target": "es2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "trss-yunzai"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },
    "outDir": "./lib",
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "ktr/template", "karin.template.ts", "web", "scripts"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
