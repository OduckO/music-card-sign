{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "endOfLine": "lf",
  "ignorePatterns": [
    "lib/**",
    ".ktr/**",
    ".test-tmp/**",
    "temp_lib_content/**",
    "pnpm-lock.yaml",
    "webadapter/*.html",
    "webadapter/app.*",
    "webadapter/fonts/**"
  ]
}
