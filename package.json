{
  "name": "music-card-sign",
  "version": "1.0.0",
  "description": "TRSS-Yunzai 本地 icqq 音卡签名服务",
  "keywords": [
    "Yunzai"
  ],
  "license": "GPL-3.0-only",
  "author": "OduckO",
  "files": [
    "./lib",
    "./resources",
    "./docs/api.md",
    "./docs/development.md",
    "./README.md",
    "./index.js",
    "./guoba.support.js",
    "./webadapter",
    "./LICENSE",
    "./package.json"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm run build:code && pnpm run build:template && pnpm run build:web",
    "build:code": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:template": "ktr build",
    "dev:template": "ktr dev",
    "build:web": "node scripts/build-web.ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json && tsc-alias -p tsconfig.test.json",
    "test": "pnpm run build && pnpm run build:test && node --test .test-tmp/compiled/test/*.test.js",
    "lint": "oxlint --deny-warnings src test ktr web scripts karin.template.ts index.js guoba.support.js webadapter/index.js",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "3.2.4",
    "@karinjs/template-react": "0.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/trss-yunzai": "npm:@kaguyajs/trss-yunzai-types@^1.3.3",
    "express": "^5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "triptrap": "0.0.17",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9"
}
